// The whole product model: accounts and roles, the consultation pipeline,
// clients and the services they buy, projects with milestones and deliverables,
// the content calendar, KPI records, CMS content, notifications and an audit
// trail.
//
// Enums are used where the vocabulary is structural — a role or an account
// status is read by authorisation code, and a typo there is a security bug, so
// the database should refuse it. Statuses that are only ever sales or workflow
// vocabulary stay strings, because renaming a pipeline stage should not cost a
// migration.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 keeps the connection URL out of the schema: migrations read it from
// `prisma.config.ts`, and the client gets it through the driver adapter in
// `lib/db.ts`.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// What an account may do. Read by `lib/auth` on every gated request.
enum Role {
  REGISTERED_USER
  TEAM_MEMBER
  ADMIN
}

/// Where a registered user sits commercially. Only meaningful for
/// `REGISTERED_USER`: staff accounts carry `NON_CLIENT` and ignore it.
enum UserStatus {
  NON_CLIENT
  CLIENT
}

/// Every account, whatever its role.
///
/// One table rather than one per role: the login, the session and the password
/// reset are identical for all three, and the differences are two columns and
/// an optional profile row. Staff accounts are made by an admin or the seed
/// script; visitors self-register and land as REGISTERED_USER / NON_CLIENT.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(REGISTERED_USER)
  status       UserStatus @default(NON_CLIENT)
  name         String?
  phone        String?
  businessName String?
  businessType String?
  /// Set when an admin suspends the account, null when it is in good standing.
  ///
  /// A column rather than a third `UserStatus`: status says where someone sits
  /// commercially, and suspending a client would otherwise erase the fact that
  /// they are one. The data access layer refuses a suspended account on every
  /// gated request, so a live session ends on the next page load.
  suspendedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clientProfile Client?
  teamProfile   TeamMember?
  consultations Consultation[]
  notifications Notification[]
  comments      Comment[]
  leads         Lead[]
  auditEntries  AuditLog[]
  assistantChats AssistantConversation[]

  @@index([role])
  @@index([status])
}

/// A member of staff, and the clients they are the named contact for.
model TeamMember {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  roleTitle String?
  createdAt DateTime @default(now())

  /// The accounts this person is the *named contact* for. One each.
  managedClients Client[]
  /// The accounts they work on. Many each, and independent of the above — a
  /// designer is on six accounts and the named contact for none of them.
  assignments    ClientAssignment[]
}

/// A team member working on a client, beyond the single account manager.
///
/// A join table rather than more columns on `Client`: the PRD asks for "assign
/// team members" and the number of them is not fixed, so the alternative would
/// be a fixed set of slots that runs out. The account manager stays its own
/// relation because it is a different fact — one person answers the phone.
model ClientAssignment {
  id           String     @id @default(cuid())
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  member       TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String
  createdAt    DateTime   @default(now())

  @@unique([clientId, teamMemberId])
  @@index([teamMemberId])
}

/// A paying client. One per user, created when an admin activates them.
model Client {
  id               String      @id @default(cuid())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String      @unique
  accountManager   TeamMember? @relation(fields: [accountManagerId], references: [id], onDelete: SetNull)
  accountManagerId String?
  companyName      String?
  onboardedAt      DateTime?
  notes            String?
  createdAt        DateTime    @default(now())

  services        ClientService[]
  projects        Project[]
  calendarEntries ContentCalendarEntry[]
  kpis            KPIRecord[]
  assignments     ClientAssignment[]

  @@index([accountManagerId])
}

// ---------------------------------------------------------------------------
// Demand: leads and consultations
// ---------------------------------------------------------------------------

/// Every enquiry from the site. Mirrors the `Lead` type in `app/actions.ts`,
/// which is what both the booking funnel and the contact form already send.
///
/// `kind` and `status` are strings rather than enums on purpose: the sales
/// vocabulary is still moving, and renaming a stage should not cost a
/// migration. `kind` is booking | contact. `status` walks the pipeline in
/// `lib/leads/schema.ts`.
model Lead {
  id            String    @id @default(cuid())
  kind          String
  name          String
  email         String
  phone         String?
  company       String?
  website       String?
  industry      String?
  service       String?
  budget        String?
  preferredDate String?
  preferredTime String?
  message       String?
  status        String    @default("new")
  /// Set when a lead is matched to an account, so the pipeline and the
  /// dashboard stop being two separate stories about the same person.
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  /// When the team notification email went out. Null means the lead is saved
  /// but nobody has been told — worth surfacing rather than retrying blindly.
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  consultations Consultation[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

/// A booked or requested call. Created from a lead by the team, or by a
/// registered user asking for one from their dashboard.
model Consultation {
  id          String    @id @default(cuid())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  /// requested | scheduled | completed | cancelled
  status      String    @default("requested")
  scheduledAt DateTime?
  topic       String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Delivery: services, projects, deliverables, calendar
// ---------------------------------------------------------------------------

/// What the agency sells. Seeded from `lib/content.ts` so the catalogue and
/// the marketing site cannot drift apart.
model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  code      String?
  createdAt DateTime @default(now())

  clientServices ClientService[]
  projects       Project[]
  kpis           KPIRecord[]
}

/// A service a client is actually on.
model ClientService {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  /// active | paused | ended
  status    String   @default("active")
  startedAt DateTime @default(now())

  @@unique([clientId, serviceId])
}

/// A body of work for one client under one service.
model Project {
  id        String    @id @default(cuid())
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId String
  name      String
  /// active | paused | complete
  status    String    @default("active")
  /// 0–100, set by the team. Stored rather than derived from milestones: a team
  /// often knows a project is 70% done before the next milestone ticks over.
  progress  Int       @default(0)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  milestones   Milestone[]
  deliverables Deliverable[]

  @@index([clientId])
}

model Milestone {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  /// Explicit ordering, because a plan is a sequence and creation time is not.
  position    Int       @default(0)

  @@index([projectId])
}

/// Something the client is meant to look at: a poster, a reel, a report.
///
/// `fileUrl` is a link rather than a blob: at this tier the cheapest storage is
/// whatever the team already uses, and large video would exhaust a free object
/// store first. Swapping in Vercel Blob later changes how the URL is produced,
/// not what is stored here.
model Deliverable {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  /// poster | reel | blog | report | source_file | other
  type        String   @default("other")
  fileUrl     String
  /// draft | submitted | approved | changes_requested
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  submittedAt DateTime?
  decidedAt   DateTime?

  comments Comment[]

  @@index([projectId])
  @@index([status])
}

/// The conversation on a deliverable. Both sides write here.
model Comment {
  id            String      @id @default(cuid())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  body          String
  createdAt     DateTime    @default(now())

  @@index([deliverableId])
}

/// One planned post, with its approval state.
model ContentCalendarEntry {
  id             String   @id @default(cuid())
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  platform       String
  caption        String?
  creativeUrl    String?
  publishDate    DateTime
  /// pending | approved | changes_requested
  approvalStatus String   @default("pending")
  note           String?
  createdAt      DateTime @default(now())

  @@index([clientId, publishDate])
}

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------

/// One number, for one client, for one period.
///
/// Entered by hand to begin with. `source` records where it came from so a
/// later Meta or Google sync can overwrite its own rows without touching
/// anything a human typed.
model KPIRecord {
  id         String   @id @default(cuid())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId  String?
  metricName String
  value      Float
  unit       String?
  /// The month, as `YYYY-MM`. A string because it is a label, not an instant.
  period     String
  /// manual | meta | google
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  @@unique([clientId, serviceId, metricName, period])
  @@index([clientId, period])
}

// ---------------------------------------------------------------------------
// Content and housekeeping
// ---------------------------------------------------------------------------

/// Editable public content: pages, posts, case studies, FAQ entries.
model CMSContent {
  id          String    @id @default(cuid())
  /// page | blog | case_study | faq | service
  type        String
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  coverUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, publishedAt])
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  message   String
  /// Where clicking it should go, when there is somewhere useful.
  href      String?
  type      String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Key/value configuration an admin can edit without a deploy.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Who did what. Written on the actions that change someone else's access or
/// money — activations, service assignments, staff accounts, deletions.
model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// The assistant
// ---------------------------------------------------------------------------

/// One visitor's conversation with the growth assistant.
///
/// Kept so the admin side can read what people actually ask — which is the
/// cheapest market research the agency has, and the only way to notice that the
/// assistant is answering something wrong. `userId` is set when the visitor
/// happened to be signed in and null otherwise; nothing here identifies a guest
/// beyond what they typed, and no IP address is stored.
model AssistantConversation {
  id            String   @id @default(cuid())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  /// Bumped on every exchange, so the list can be ordered by activity rather
  /// than by when a conversation happened to start.
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages AssistantMessage[]

  @@index([lastMessageAt])
}

/// One turn. `role` is user | assistant, matching what the panel sends.
model AssistantMessage {
  id             String                @id @default(cuid())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String
  body           String
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

/// One row per key per time window, for the assistant's rate limit.
///
/// Serverless instances share no memory, so an in-process counter would reset
/// on every cold start and let a scripted client through at will. A row is the
/// cheapest thing that actually holds across instances.
model RateHit {
  id        String   @id @default(cuid())
  key       String
  window    String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([key, window])
  @@index([createdAt])
}
